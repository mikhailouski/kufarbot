# Токен Telegram-бота (получите у @BotFather).
BOT_TOKEN=

# Ваш Telegram user id — только ему бот отвечает и шлёт уведомления.
# Узнать свой ID: напишите @userinfobot в Telegram.
ADMIN_USER_ID=

# Как часто проверять разделы, секунд (по умолчанию 60).
CHECK_INTERVAL=60

# Сколько объявлений брать за один опрос раздела.
CHECK_SIZE=50

# Максимум уведомлений за один цикл проверки.
MAX_SEND_PER_CHECK=15